#!/bin/bash

APPDEST="${TRIM_APPDEST:-/tmp/cinelinknative-app}"
PKGVAR="${TRIM_PKGVAR:-/tmp/cinelinknative-var}"
LOG_FILE="${PKGVAR}/config.log"

mkdir -p "$PKGVAR" >/dev/null 2>&1 || true
touch "$LOG_FILE" >/dev/null 2>&1 || LOG_FILE="/tmp/cinelinknative-config.log"
exec >>"$LOG_FILE" 2>&1

echo "[config_callback] start $(date '+%F %T')"

DEFAULT_CONFIG_DIR="${PKGVAR}/config"
DEFAULT_MEDIA_DIR="${PKGVAR}/media"
SUGGEST_CONFIG_DIR="/vol1/@appdata/cinelinknative/config"
SUGGEST_MEDIA_DIR="/vol1/@appdata/cinelinknative/media"

CONFIG_DIR="${wizard_cinelink_config_dir:-$SUGGEST_CONFIG_DIR}"
MEDIA_DIR="${wizard_cinelink_media_dir:-$SUGGEST_MEDIA_DIR}"
WEB_PORT="${wizard_cinelink_web_port:-8000}"
PLAY_PUBLIC_URL="${wizard_cinelink_play_public_url:-http://127.0.0.1:${WEB_PORT}}"
ENV_FILE="${APPDEST}/cinelinknative.env"
UI_CONFIG="${APPDEST}/ui/config"

prepare_dir() {
    local desired="$1"
    local fallback="$2"
    if mkdir -p "$desired" "$desired/alist" "$desired/logs" >/dev/null 2>&1; then
        printf '%s' "$desired"
        return 0
    fi
    echo "[config_callback] cannot create $desired, fallback to $fallback" >&2
    mkdir -p "$fallback" "$fallback/alist" "$fallback/logs" >/dev/null 2>&1 || true
    printf '%s' "$fallback"
}

prepare_media_dir() {
    local desired="$1"
    local fallback="$2"
    if mkdir -p "$desired" >/dev/null 2>&1; then
        printf '%s' "$desired"
        return 0
    fi
    echo "[config_callback] cannot create $desired, fallback to $fallback" >&2
    mkdir -p "$fallback" >/dev/null 2>&1 || true
    printf '%s' "$fallback"
}

CONFIG_DIR="$(prepare_dir "$CONFIG_DIR" "$DEFAULT_CONFIG_DIR")"
MEDIA_DIR="$(prepare_media_dir "$MEDIA_DIR" "$DEFAULT_MEDIA_DIR")"
mkdir -p "$APPDEST" >/dev/null 2>&1 || true

cat > "$ENV_FILE" <<EOF
CINELINK_FNOS_CONFIG_DIR=$CONFIG_DIR
CINELINK_FNOS_MEDIA_DIR=$MEDIA_DIR
CINELINK_FNOS_WEB_PORT=$WEB_PORT
CINELINK_FNOS_PLAY_PUBLIC_URL=$PLAY_PUBLIC_URL
EOF

if [ -f "$UI_CONFIG" ]; then
    sed -i "s/\"port\": \"[0-9][0-9]*\"/\"port\": \"$WEB_PORT\"/" "$UI_CONFIG"
fi

echo "[config_callback] done config=$CONFIG_DIR media=$MEDIA_DIR port=$WEB_PORT"
exit 0
